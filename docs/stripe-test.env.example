# Non-secret test configuration only. Never put a key or whsec into this file.
# The runtime does not automatically source/load it. Set these in your process
# environment using your approved local setup. The runner reads the test key
# from the macOS Keychain service tojima-stripe-sandbox by default.
TOJIMA_STRIPE_MODE=CONNECTED_DIRECT_TEST_FIXTURE
TOJIMA_STRIPE_API_VERSION=2026-09-30.endive
# Positive ceiling <= 10000 JPY, shared by Checkout and full/partial refund checks.
TOJIMA_STRIPE_TEST_MAX_AMOUNT_JPY=10000
# Optional overrides; defaults are the approved synthetic Sandbox merchants.
# TOJIMA_STRIPE_TEST_ACCOUNT_A=acct_1UUXcL1Hm4VOReK9
# TOJIMA_STRIPE_TEST_ACCOUNT_B=acct_1UUXd51Hm4v7xrOu
# TOJIMA_STRIPE_TEST_ACCOUNT_C=acct_1UUXdU1Hm4vaUfKX
TEST_DATABASE_URL=postgres://postgres@127.0.0.1:55444/tojima_test?sslmode=disable

# Required secrets are deliberately absent:
# TOJIMA_STRIPE_TEST_SECRET_KEY: read from Keychain (or explicitly use --prompt-key).
# TOJIMA_STRIPE_TEST_WEBHOOK_SECRET: obtained only in memory by the CLI wrapper.

# P-82 refunds/partial refunds and P-83 ORDER_READ are integrated; real Sandbox
# acceptance remains required. See docs/p80-stripe-test-runtime.md for Owner steps.
# JA: 全額・部分返金もSandbox受入対象。keyは保存しない。
# ZH: 整筆／部分退款亦屬Sandbox驗收；不可儲存key。
