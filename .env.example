# Non-secret local HTTP listener configuration.
APP_ADDR=127.0.0.1:8080

# Local container stack (compose.yaml): copy this file to .env and replace the
# placeholder password and PIN_PEPPER. .env is git-ignored; never commit a real password.
# Any password characters work: compose passes it through PGPASSWORD, not a URL.
POSTGRES_DB=tojima
POSTGRES_USER=tojima
POSTGRES_PASSWORD=change-me-local-only

# Host interface and port published for the server container.
APP_BIND=127.0.0.1
APP_PORT=8080

# Explicit LOCAL EXAMPLE policy; production policy still needs Owner acceptance.
# Durations use Go syntax (h, m, s, ms). No harness policy is silently inherited.
SESSION_TTL=4h
GRANT_TTL=1h
GRANT_WINDOW=1m
GRANT_WINDOW_MAX=100
PIN_TTL=15m
PIN_LOCKOUT=1m
PIN_MAX_ATTEMPTS=3
PIN_LENGTH=6
# Generate locally with: openssl rand -base64 32
# Keep the real value stable across restarts; never commit it.
PIN_PEPPER=replace-with-generated-base64-secret
PAYMENT_CREATE_RETRY_WINDOW=20h
PAYMENT_CONTINUATION_TTL=30m
PAYMENT_WORK_LEASE_TTL=30s

# Stripe is disabled. See docs/ops/containers.md for opt-in test configuration.
STRIPE_MODE=disabled
