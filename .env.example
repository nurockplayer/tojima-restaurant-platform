# Non-secret local HTTP listener configuration.
APP_ADDR=127.0.0.1:8080

# Local container stack (compose.yaml): copy this file to .env and replace the
# placeholder password and PIN_PEPPER. .env is git-ignored; never commit a real password.
# Any password characters work: compose passes it through PGPASSWORD, not a URL.
POSTGRES_DB=tojima
POSTGRES_USER=tojima
POSTGRES_PASSWORD=change-me-local-only
# Server runtime role (DML only): migrate grants it access after every run.
# A fresh volume creates it through deploy/postgres/initdb/20-app-role.sh.
APP_DB_USER=tojima_app
APP_DB_PASSWORD=change-me-app-local-only

# Host interface and port published for the server container.
APP_BIND=127.0.0.1
APP_PORT=8080

# Explicit LOCAL EXAMPLE policy; production policy still needs Owner acceptance.
# Durations use Go syntax (h, m, s, ms). No harness policy is silently inherited.
SESSION_TTL=4h
GRANT_TTL=1h
GRANT_WINDOW=1m
GRANT_WINDOW_MAX=100
PIN_TTL=15m
PIN_LOCKOUT=1m
PIN_MAX_ATTEMPTS=3
PIN_LENGTH=6
# Generate locally with: openssl rand -base64 32
# Keep the real value stable across restarts; never commit it.
PIN_PEPPER=replace-with-generated-base64-secret
PAYMENT_CREATE_RETRY_WINDOW=20h
PAYMENT_CONTINUATION_TTL=30m
PAYMENT_WORK_LEASE_TTL=30s

# Stripe is disabled. See docs/ops/containers.md for opt-in test configuration.
STRIPE_MODE=disabled

# Staff sign-in is opt-in: docker compose --profile staff up -d --build --wait
STAFF_AUTH_MODE=disabled
KEYCLOAK_PORT=8081
KEYCLOAK_DB_PASSWORD=change-me-keycloak-db-local-only
KC_BOOTSTRAP_ADMIN_USERNAME=bootstrap-admin
KC_BOOTSTRAP_ADMIN_PASSWORD=change-me-bootstrap-admin-local-only
KEYCLOAK_PUBLIC_URL=http://127.0.0.1:8081
# Keycloak reaches the BFF over the Compose network; change if the BFF runs elsewhere.
KEYCLOAK_BACKCHANNEL_LOGOUT_URL=http://server:8080/staff/auth/backchannel-logout
# Generate with: openssl rand -base64 48. Set BOTH client-secret variables to it.
TOJIMA_STAFF_CLIENT_SECRET=replace-with-generated-staff-client-secret
STAFF_OIDC_CLIENT_ID=tojima-staff
STAFF_OIDC_CLIENT_SECRET=replace-with-the-same-generated-staff-client-secret
# The validated issuer MUST match KC_HOSTNAME (KEYCLOAK_PUBLIC_URL), not the
# internal discovery address http://keycloak:8080/realms/tojima.
STAFF_OIDC_ISSUER=http://127.0.0.1:8081/realms/tojima
# Optional same-realm private discovery; exact public issuer validation stays on.
STAFF_OIDC_DISCOVERY_URL=http://keycloak:8080/realms/tojima
# Uncomment when STAFF_AUTH_MODE=oidc (or for Stripe's separately required HTTPS origin).
# APP_PUBLIC_ORIGIN=http://127.0.0.1:8080
